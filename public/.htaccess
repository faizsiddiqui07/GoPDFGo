# ===== Caching =============================================================
# Pages were going out with no Cache-Control at all, so browsers fell back to
# their own heuristic and held them. A page is what names the content-hashed
# CSS and JS, so a stale page keeps requesting the PREVIOUS deploy's assets --
# which is how a fix that is already sitting on the server stays invisible in
# the browser. ETag and Last-Modified are still sent, so revalidating a page
# costs one 304, not a re-download.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, must-revalidate"

  # Nested so that a host without mod_setenvif falls back to plain no-cache
  # rather than erroring -- a broken .htaccess takes the whole site down.
  <IfModule mod_setenvif.c>
    # Images and fonts are NOT hashed, so they must stay replaceable under the
    # same name. They change rarely though, and revalidating every one on every
    # page view is waste, so a day is the compromise.
    SetEnvIf Request_URI "\.(webp|png|jpe?g|gif|svg|ico|woff2?)$" GPG_MEDIA
    Header set Cache-Control "public, max-age=86400" env=GPG_MEDIA

    # Everything under _next/static carries a content hash in its filename, so
    # one URL can never mean two different things. Listed last so it wins over
    # the media rule for hashed images. Safe to keep for a year.
    SetEnvIf Request_URI "^/_next/static/" GPG_IMMUTABLE
    Header set Cache-Control "public, max-age=31536000, immutable" env=GPG_IMMUTABLE
  </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
  # Security: directory listing + content-negotiation band rakho
  Options -Indexes -MultiViews
  RewriteEngine On

  # 0. Dotfiles bahar se serve mat karo. FTP deploy action har deploy par
  #    .ftp-deploy-sync-state.json web root me likhta hai -- server ki poori
  #    file list (1000+ entries), jo abhi HTTP 200 par koi bhi padh sakta hai.
  #    Usme koi password nahi hai aur SEO/traffic par zero asar hai, par ise
  #    publicly padhne ki kisi ko zaroorat bhi nahi. Deploy action yeh file FTP
  #    se padhta hai, HTTP se nahi -- isliye block karne se deploy nahi tootega.
  #    Ek naam ki jagah poori dotfile class band ki hai, taaki aage koi aur
  #    dotfile aa jaye to wo bhi apne aap dhak jaye.
  #    .well-known chhoda hai: SSL certificate renewal wahi se hota hai.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]

  # 1. Ek hi redirect me HTTPS + non-www force karo (path/query preserve hota hai)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.gopdfgo\.com$ [NC]
  RewriteRule ^ https://gopdfgo.com%{REQUEST_URI} [L,R=301]

  # 1b. Raw ".html" URL ko clean URL par 301 karo (duplicate-URL band karo).
  #     %{THE_REQUEST} ORIGINAL request line dekhta hai -- isliye niche rule 3 ki
  #     andar-hi-andar hone wali (x -> x.html) rewrite par yeh fire NAHI hota,
  #     yaani koi redirect loop nahi banta. Query string default se preserve hoti hai.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 1c. /blog aur /blog/ ka apna koi page nahi hai -- blog/ folder me sirf
  #     alag-alag post pages hain. Dono ko asli index /blogs par 301 karo.
  #     Pattern $ se anchored hai, isliye /blog/<slug> post URLs par NAHI chalta.
  RewriteRule ^blog/?$ /blogs [R=301,L]

  # 2. Trailing slash HATAO (301) -- sirf tab jab no-slash ".html" page मौजूद ho.
  #    Yeh leftover /x/ folder hone par bhi chalta hai, aur asli asset folders par loop nahi karta.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/$ /$1 [L,R=301]

  # 3. Clean /x URL ke liye andar-hi-andar x.html serve karo (koi redirect nahi)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 4. 404 Error Page
  ErrorDocument 404 /404.html
</IfModule>
